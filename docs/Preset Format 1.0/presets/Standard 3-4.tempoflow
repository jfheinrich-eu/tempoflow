{
    "schema": "tempoflow-preset",
    "schemaVersion": "1.0.0",
    "metadata": {
        "name": "Standard 3-4",
        "description": "A standard 3/4 time signature preset with an accent on beat 1.",
        "author": "Jörg Heinrich",
        "createdAt": "2026-09-06T22:33:00+02:00",
        "updatedAt": "2026-09-06T22:33:00+02:00"
    },
    "tempo": {
        "bpm": 120
    },
    "meter": {
        "numerator": 3,
        "denominator": 4,
        "grouping": [
            1,
            1,
            1
        ]
    },
    "subdivision": {
        "mode": "none",
        "partsPerBeat": 1
    },
    "pattern": {
        "beats": [
            {
                "beat": 1,
                "click": "accent"
            },
            {
                "beat": 2,
                "click": "normal"
            },
            {
                "beat": 3,
                "click": "normal"
            }
        ]
    },
    "sound": {
        "soundSet": "default",
        "volume": 0.8
    },
    "playback": {
        "mode": "host"
    }
}
